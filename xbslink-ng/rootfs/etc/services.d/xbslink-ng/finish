#!/usr/bin/env bashio
# ==============================================================================
# Take down the S6 supervision tree when xbslink-ng fails
# s6-overlay docs: https://github.com/just-containers/s6-overlay
# ==============================================================================

declare APP_EXIT_CODE=${1}

if [[ "${APP_EXIT_CODE}" -ne 0 ]] && [[ "${APP_EXIT_CODE}" -ne 256 ]]; then
  bashio::log.warning "XBSLink-NG exited with code ${APP_EXIT_CODE}"

  # Exit code 1 usually means configuration error
  if [[ "${APP_EXIT_CODE}" -eq 1 ]]; then
    bashio::log.error "Configuration error - check your settings"
  fi

  echo "${APP_EXIT_CODE}" > /run/s6-linux-init-container-results/exitcode
  exec /run/s6/basedir/bin/halt
fi

bashio::log.info "XBSLink-NG service restarting..."
